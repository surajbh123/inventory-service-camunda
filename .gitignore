# Generic .gitignore — OS, editors, languages, build artifacts

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / env
.env
.env.*.local
.env.local

# Node
node_modules/
dist/
build/
.cache/
.next/
out/
.pnp.cjs
.pnp.loader.mjs

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
ENV/
env/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Java / JVM
.gradle/
build/
target/
*.class
*.jar
*.war
*.ear

# Go
bin/
pkg/

# Rust
/target/

# Editors / IDEs
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.iml

# Coverage / test output
coverage/
.nyc_output/
coverage-final.json
*.lcov

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
*.pid

# Secrets / keys
*.pem
*.key
credentials.json
*.p12

# Terraform
.terraform/
*.tfstate
*.tfstate.backup

# Docker
docker-compose.override.yml
